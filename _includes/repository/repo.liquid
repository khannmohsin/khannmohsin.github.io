{% assign repo_url = include.repository | split: '/' %}

<li data-repo-item>
  <div class="ghpinned-card" data-repo="{{ include.repository }}" data-repo-search="{{ include.repository | downcase }}" data-repo-stars="0" data-repo-language="">
    <div class="title">
      <a href="https://github.com/{{ include.repository }}" target="_blank" rel="noopener noreferrer" aria-label="Open {{ include.repository }} on GitHub">
        {{ repo_url[1] }}
      </a>
    </div>

    <p class="periodical ghpinned-desc">Loading description…</p>

    <div class="periodical ghpinned-meta">
      <span class="ghpinned-langs" aria-label="Repository languages"></span>
      <span class="ghpinned-stars">⭐ <span class="ghpinned-stars-count"></span></span>
      <span class="ghpinned-forks">🍴 <span class="ghpinned-forks-count"></span></span>
    </div>
  </div>
</li>
