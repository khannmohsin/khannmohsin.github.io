{% unless page._custom_css_loaded %}
  {% assign page._custom_css_loaded = true %}
  <link rel="stylesheet" href="{{ '/assets/css/custom.css' | relative_url }}">
{% endunless %}

{% assign repo_url = include.repository | split: '/' %}

{% if site.data.repositories.repo_description_lines_max %}
  {% assign max_lines = site.data.repositories.repo_description_lines_max %}
{% else %}
  {% assign max_lines = 2 %}
{% endif %}

<div class="repo">
  <div class="ghpinned-card" data-repo="{{ include.repository }}">

    <div class="ghpinned-top">
      <div class="ghpinned-title">
        <a class="ghpinned-name"
           href="https://github.com/{{ include.repository }}"
           aria-label="Open {{ include.repository }} on GitHub">
          {{ repo_url[1] }}
        </a>
      </div>
    </div>

    <p class="ghpinned-desc">Loading description…</p>

    <div class="ghpinned-meta">
    <span class="ghpinned-langs" aria-label="Repository languages"></span>

      <span class="ghpinned-stars">⭐ <span class="ghpinned-stars-count"></span></span>
      <span class="ghpinned-forks">🍴 <span class="ghpinned-forks-count"></span></span>
    </div>

  </div>
</div>