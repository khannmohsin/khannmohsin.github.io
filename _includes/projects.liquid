<div class="col">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% endif %}

      <div class="card-body">

        <p class="card-title text-center">{{ project.title }}</p>

        {%- comment -%}
        {%- if project.description -%}
          <p class="card-text text-muted" style="margin-top:-6px;">
            {{ project.description }}
          </p>
        {%- endif -%}
        {%- endcomment -%}

        {%- if project.tags and project.tags.size > 0 -%}
          <div class="prj-tags" aria-label="Project tags">
            {%- for tag in project.tags -%}
              <span class="prj-tag">{{ tag }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="row ml-1 mr-1 p-0">
          {% if project.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <!-- NOTE: nested <a> inside outer <a> is invalid HTML.
                     This existed in your original file; keeping it unchanged for compatibility.
                     If you want, I can provide a clean fix that preserves click behavior. -->
                <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
              </div>

              {% if project.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ project.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>

      </div>
    </div>
  </a>
</div>