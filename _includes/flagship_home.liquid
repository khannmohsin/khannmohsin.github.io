{% assign flagship = site.data.flagship %}

<section class="flagship-home" aria-label="Flagship portfolio overview">
  <div class="flag-top">
    <div class="flag-hero">
      <h1 class="post-title">Hi, I am <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.last_name }}</h1>
      <p class="flag-kicker">{{ flagship.hero.kicker }}</p>
      <div class="flag-subheadline">{{ flagship.hero.subheadline }}</div>

      <div class="flag-hero-footer">
        <div class="flag-cta-row flag-hero-actions">
          {% for cta in flagship.hero.ctas %}
            {% assign cta_url = cta.url %}
            {% unless cta.url contains '://' or cta.url contains 'mailto:' %}
              {% assign cta_url = cta.url | relative_url %}
            {% endunless %}
            <a
              class="flag-btn {% if cta.style == 'primary' %}flag-btn--primary{% endif %}"
              href="{{ cta_url }}"
              {% if cta.url contains 'mailto:' or cta.url contains '.pdf' %}
                target="_blank" rel="noopener noreferrer"
              {% endif %}
            >
              {{ cta.label }}
            </a>
          {% endfor %}
        </div>

        <div class="flag-hero-social">{% include social.liquid %}</div>
      </div>
    </div>

    {% if flagship.hero.portrait and flagship.hero.portrait.path %}
      <aside class="flag-portrait-wrap" aria-label="Profile portrait">
        {% include figure.liquid loading="eager" path=flagship.hero.portrait.path sizes="(min-width: 1200px) 420px, (min-width: 992px) 34vw, (min-width: 768px) 42vw, 88vw" width="3413" height="4035" class="flag-portrait" alt=flagship.hero.portrait.alt cache_bust=true %}
      </aside>
    {% endif %}
  </div>

  {% comment %}
    <section class="flag-map" aria-label="Attack path to controls map">
      {% if flagship.threat_map.intro and flagship.threat_map.intro != "" %}
        <p class="flag-map-intro">{{ flagship.threat_map.intro }}</p>
      {% endif %}
      <div class="flag-map-stage-track" aria-label="Intrusion stages">
        {% for stage in flagship.threat_map.stages %}
          <span class="flag-map-stage-chip">{{ stage.stage }}</span>
        {% endfor %}
      </div>
      <div class="flag-map-lanes">
        <article class="flag-map-lane" aria-label="Attack lane">
          <p class="flag-map-lane-title">Attack</p>
          <ul class="flag-map-list">
            {% for stage in flagship.threat_map.stages %}
              <li class="flag-map-item">
                <span class="flag-map-item-stage">{{ stage.stage }}</span>
                <span class="flag-map-item-text">{{ stage.attack }}</span>
              </li>
            {% endfor %}
          </ul>
        </article>

        <article class="flag-map-lane" aria-label="Control lane">
          <p class="flag-map-lane-title">Control</p>
          <ul class="flag-map-list">
            {% for stage in flagship.threat_map.stages %}
              <li class="flag-map-item">
                <span class="flag-map-item-stage">{{ stage.stage }}</span>
                <span class="flag-map-item-text">{{ stage.control }}</span>
              </li>
            {% endfor %}
          </ul>
        </article>

        <article class="flag-map-lane" aria-label="Signal lane">
          <p class="flag-map-lane-title">Signal</p>
          <ul class="flag-map-list">
            {% for stage in flagship.threat_map.stages %}
              <li class="flag-map-item">
                <span class="flag-map-item-stage">{{ stage.stage }}</span>
                <span class="flag-map-item-text">{{ stage.signal }}</span>
              </li>
            {% endfor %}
          </ul>
        </article>
      </div>
    </section>
  {% endcomment %}

  {% comment %}Moved to _pages/about.md to keep it before the final card{% endcomment %}
</section>
