{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <div class="bibsearch-toolbar">
    <input
      type="text"
      id="bibsearch"
      spellcheck="false"
      autocomplete="off"
      class="search bibsearch-form-input"
      placeholder="{% if include.placeholder %}{{ include.placeholder }}{% else %}Type to filter{% endif %}"
    >
    <button id="bibsearch-button" class="aux-btn aux-btn--primary" type="button" aria-label="Search publications">Search</button>
  </div>
{% endif %}
