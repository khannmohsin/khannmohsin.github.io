
@inproceedings{khan2025lightsec,
  title={A Comparative Analysis of Lightweight Hash Functions Using AVR ATXMega128 and ChipWhisperer},
  author={Khan, Mohsin and Dagenborg, Håvard and Johansen, Dag},
  booktitle={Proceedings of Nordic Conference on Secure IT Systems (NordSec)},
  year={2025},
  location={Tartu, Estonia},
  keywords={NIST, ISO/IEC 29192-5, ChipWhisperer, ATxmega128, Sponge Construction, E-RANK Metric},
  pdf={NordSec.pdf},
  selected={true},
  html={https://arxiv.org/abs/2508.07840},
  abstract={Lightweight hash functions have become important building blocks for security in embedded and IoT systems. A plethora of algorithms have been proposed and standardized, providing a wide range of performance trade-off options for developers to choose from. This paper presents a comparative analysis of 22 key software-based lightweight hash functions, including the finalist from the SHA-3 competition. We use a novel benchmark methodology that combines an AVR ATXMega128 microcontroller with the ChipWhisperer cryptanalysis platform and evaluate and compare the various hash functions along several dimensions, including execution speed, % measured in Cycles per Byte (CpB), memory footprint, and energy consumption. Using the composite E-RANK metric, we provide new insight into the various trade-offs each hash function offers to system developers.},
  preview={schedule.png},
}

@article{khan2025survey,
  title        = {Survey of Lightweight Hardware-Based Hash Functions for Security in Constrained IoT Devices},
  author       = {Khan, Mohsin and Kozyri, Elisavet and Johansen, Dag and Dagenborg, Håvard},
  journal      = {IEEE Access},
  volume       = {13},
  pages        = {164508--164527},
  year         = {2025},
  publisher    = {IEEE},
  html         = {https://ieeexplore.ieee.org/abstract/document/11168213},
  pdf          = {khan2025survey.pdf},
  abstract     = {This survey provides a comprehensive analysis of lightweight hardware-based hash functions designed for security in constrained IoT devices. It examines the architectural design of sponge- and cipher-based constructions, compares performance metrics such as throughput, area, and energy cost, and analyzes cryptanalytic findings to understand practical security trade-offs. The work offers a structured framework for selecting efficient, resource-aware hash functions suitable for next-generation IoT deployments.},
  keywords     = {Lightweight hash functions, IoT security, Hardware implementations, Sponge construction, Cipher-based construction, Performance evaluation, Embedded systems},
  selected     = {true},
  preview      = {ieeeaccess.jpg}
}

@inproceedings{ovesen2025fmec,
  title={System Support for Accountable and Trusted Data Collection and Fog Processing in Remote Electronic Monitoring},
  author={Ovesen, A.B. and Khan, Mohsin and Dagenborg, Håvard and Johansen, Dag},
  booktitle={Proceedings of International Conference on Fog and Mobile Edge Computing (FMEC)},
  year={2025},
  keywords={Edge Computing, Fog Processing, Remote Electronic Monitoring (REM), Data Provenance},
  pdf={fmec.pdf},
  selected={true},
  location={Florida, USA},
  html={https://ieeexplore.ieee.org/abstract/document/11119373},
  abstract={Edge data collection systems play an increasingly important role in enabling digital forensics, by facilitating the secure and efficient capture, processing, and transmission of data from remote environments. These systems, however, face challenges related to data integrity, privacy, and accountability, especially when dealing with sensitive data in compliance-driven domains such as video surveillance. Remote Electronic Monitoring systems in industrial fisheries exemplify these challenges, through their deployment in harsh and privacy-sensitive environments. While this field has primarily been focused on challenges with catch estimation and sustainability, this paper describes how the Dorvu system provides support for accountable, traceable, and verifiable edge data collection and processing. This is achieved by providing different stakeholders, such as data subjects and legal authorities, with mechanisms that can be used to verify collected data, monitor system behavior, and challenge decisions made on the grounds of system output, and as such hold the system accountable, while it is deployed in remote areas.},
  preview={IEEE.png},
}

@inproceedings{khan2025secrypt,
  title={Software Benchmarking of NIST Lightweight Hash Function Finalists on Resource-Constrained AVR Platform via ChipWhisperer},
  author={Khan, Mohsin and Dagenborg, Håvard and Johansen, Dag},
  booktitle={Proceedings of International Conference on Security and Cryptography (SECRYPT)},
  year={2025},
  publisher={SCITEPRESS – Science and Technology Publications},
  pdf={secrypt.pdf},
  html={https://www.scitepress.org/PublishedPapers/2025/135607/},
  location={BilBao, Spain},
  keywords={NIST, Lightweight Hash Functions, ChipWhisperer, ATxmega128, E-RANK, Embedded Benchmarking},
  selected={true},
  abstract={This paper presents a novel performance evaluation of five key lightweight hash functions on an ATxmega128 microcontroller, using our E-RANK metric as a composite metric that integrates execution speed, memory footprint, and energy efficiency into a unified and balanced ranking. We leverage hardware-specific profiling techniques using the ChipWhisperer FPGA toolkit to capture power traces and execution metrics. The findings offer fine-grained insights into which LWHFs are best suited for constrained IoT environments.},
  preview={secrypt.png},
}

